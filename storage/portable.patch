 	})
 	return err
 }
+
+// renameShare changes the public ID and settings in one transaction.
+func (p *BoltProvider) renameShare(oldID string, share *Share) error {
+ if err:=share.validate();err!=nil{return err}
+ return p.dbHandle.Update(func(tx *bolt.Tx) error {
+  bucket,err:=p.getSharesBucket(tx);if err!=nil{return err}
+  raw:=bucket.Get([]byte(oldID));if raw==nil{return util.NewRecordNotFoundError("Share does not exist")}
+  var old Share;if err=json.Unmarshal(raw,&old);err!=nil{return err}
+  if old.Username!=share.Username{return util.NewRecordNotFoundError("Share does not exist")}
+  if bucket.Get([]byte(share.ShareID))!=nil{return util.NewValidationError("这个分享后缀已被占用，请换一个")}
+  share.ID=old.ID;share.CreatedAt=old.CreatedAt;share.LastUseAt=old.LastUseAt;share.UsedTokens=old.UsedTokens;share.UpdatedAt=util.GetTimeAsMsSinceEpoch(time.Now())
+  data,err:=json.Marshal(share);if err!=nil{return err}
+  if err=bucket.Put([]byte(share.ShareID),data);err!=nil{return err}
+  return bucket.Delete([]byte(oldID))
+ })
+}
