# Complete the initial admin setup locally before enabling LAN access.
NAS_BIND=127.0.0.1
NAS_PORT=8088
NAS_REGISTRATION_ENABLED=true
NAS_REGISTRATION_QUOTA_GB=50
# Optional reverse proxy IPs/CIDRs, comma-separated. Empty means no trusted proxies.
# Configure only a proxy that overwrites or safely appends X-Forwarded-For.
NAS_TRUSTED_PROXIES=
